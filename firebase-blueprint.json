{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "emailVerified": { "type": "boolean" },
        "displayName": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Watchlist": {
      "title": "Watchlist",
      "description": "User's watchlist items",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "required": ["userId", "items"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "watchlists/{userId}": {
      "schema": "Watchlist",
      "description": "User's personal watchlist"
    }
  }
}
