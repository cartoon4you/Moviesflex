{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "maxLength": 150
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": ["userId", "email"]
    },
    "WatchlistItem": {
      "title": "WatchlistItem",
      "description": "An item saved to the user's personal watchlist",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 256
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "poster": {
          "type": "string",
          "maxLength": 1000
        },
        "rating": {
          "type": "string",
          "maxLength": 50
        },
        "year": {
          "type": "string",
          "maxLength": 50
        },
        "type": {
          "type": "string",
          "maxLength": 50
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "addedAt": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": ["id", "title", "userId"]
    },
    "MediaCache": {
      "title": "MediaCache",
      "description": "Cached scraping results with TTL expiration timestamp",
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 512
        },
        "data": {
          "type": "string",
          "description": "JSON stringified media data"
        },
        "expiresAt": {
          "type": "number",
          "description": "Expiration timestamp in epoch ms"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": ["key", "data", "expiresAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document storing basic account metadata"
    },
    "/users/{userId}/watchlist/{itemId}": {
      "schema": "WatchlistItem",
      "description": "Items added by the user to their personal watchlist"
    },
    "/media_cache/{cacheId}": {
      "schema": "MediaCache",
      "description": "Persistent scrape cache entries for home content, media details, search, and streams"
    }
  }
}
